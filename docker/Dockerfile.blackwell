# FoundationPose + SAM2 on NVIDIA Blackwell (RTX 50-series, sm_120).
#
# The original docker/dockerfile targets cudagl:11.3 + torch 2.0/cu118, which has no
# sm_120 kernels and cannot run on a 5070 Ti. This image is CUDA 12.8 / torch 2.8 / cu128.
#
# Kaolin is intentionally omitted: it is only imported lazily by the model-free (NeRF)
# path in Utils.py. The model-based demo/tracking path does not need it.

FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Europe/Istanbul \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# sm_120 = Blackwell. Consumed by the pytorch3d source build below and, at runtime,
# by nvdiffrast's JIT extension build.
ENV TORCH_CUDA_ARCH_LIST="12.0" \
    FORCE_CUDA=1 \
    CUDA_HOME=/usr/local/cuda \
    OPENCV_IO_ENABLE_OPENEXR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git wget curl vim tmux unzip pkg-config ca-certificates \
      python3 python3-dev python3-pip python3-venv \
      libboost-system-dev libboost-program-options-dev libeigen3-dev \
      libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 \
      libegl1 libgles2 libglvnd-dev freeglut3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python && python -m pip install --upgrade pip setuptools wheel

# --- PyTorch (cu128 is the first build line with real sm_120 kernels) -------------------
RUN pip install torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0 \
      --index-url https://download.pytorch.org/whl/cu128

# --- Build deps for the CUDA extensions ------------------------------------------------
RUN pip install ninja "pybind11[global]" numpy

# --- pytorch3d (source build; ~20-40 min). @stable is too old for torch 2.8. ------------
RUN MAX_JOBS=8 pip install --no-build-isolation \
      "git+https://github.com/facebookresearch/pytorch3d.git@main"

# --- nvdiffrast (CUDA kernels JIT-compile on first use, but setup.py imports torch, so
#     it needs --no-build-isolation too) --------------------------------------------------
RUN pip install --no-build-isolation "git+https://github.com/NVlabs/nvdiffrast.git"

# --- FoundationPose python deps --------------------------------------------------------
RUN pip install \
      scipy scikit-learn scikit-image h5py joblib \
      "PyYAML>=6" "ruamel.yaml>=0.18" "omegaconf>=2.3" \
      opencv-python opencv-contrib-python imageio imageio-ffmpeg open3d trimesh transformations \
      matplotlib pandas Pillow pyrender "pyOpenGL>=3.1" \
      "kornia>=0.7" warp-lang einops timm psutil tqdm numba \
      xatlas rtree pypng roma seaborn videoio pycocotools

# --- SAM2 ------------------------------------------------------------------------------
# Cloned (not pip-from-git) so the configs, notebooks and checkpoint script are on disk
# and hackable. SAM2_BUILD_CUDA=0: the CUDA ext is optional post-processing only and its
# absence just disables a mask-refinement step.
ENV SAM2_BUILD_CUDA=0
RUN git clone https://github.com/facebookresearch/sam2.git /opt/sam2 && \
    cd /opt/sam2 && pip install -e ".[notebooks]"

# jupyter for playground work
RUN pip install jupyterlab ipywidgets

ENV SHELL=/bin/bash
RUN ln -sf /bin/bash /bin/sh
WORKDIR /workspace
CMD ["bash"]
